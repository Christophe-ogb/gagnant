# Créez une base Redis Upstash, puis renseignez ces deux variables dans Vercel.
# En production, elles sont requises pour limiter les requêtes sensibles et le compteur de visiteurs.
UPSTASH_REDIS_REST_URL="https://votre-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="votre-jeton-redis"

# Supabase : paramètres publics du projet, utilisés par l'authentification et les formulaires.
# La clé service_role ne doit jamais être utilisée pour ces variables NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-cle-anon-ou-publishable"
NEXT_PUBLIC_SITE_URL="https://gagnant.vercel.app"

# Clé secrète utilisée uniquement par les routes serveur pour les témoignages publics.
# Ne jamais la préfixer par NEXT_PUBLIC_ ni l’exposer dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY="votre-cle-secrete-service-role"

# Envoi des annonces aux membres qui ont accepté de les recevoir.
# Ces variables restent côté serveur : ne préfixez aucune d’elles par NEXT_PUBLIC_.
BREVO_API_KEY="votre-cle-api-brevo"
BREVO_SENDER_EMAIL="annonces@votre-domaine.com"
BREVO_SENDER_NAME="GAGNANTS229"
APP_BASE_URL="https://votre-domaine.com"
